# Groq API Key (Required for Llama LLM models)
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API Key (Required for Web/Hotel Search MCP Server)
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack API Key (Required for Flight MCP Server)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeather API Key (Required for Weather MCP Server)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# PostgreSQL Connection String (Required for PostgresSaver Checkpointer)
# Format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db

# LangGraph Development / Studio Mode (Set to 1 when using 'langgraph dev')
LANGGRAPH_DEV=0
